# @file
# @brief Text-based implementation of `backend-api.shl` relying on character streams for input and output (~TTY).
# @description
# This implementation deliberately separates stdin/stdout/stderr handling from the output and user interaction on tty.
# As a consequence, the default behaviour expects `/dev/tty` to exist and be accessible.
# Refer to [Configuration](#configuration) for more details. 
#
# **Reason:**  
# This implementation might also be used/spawned from other commands and processes which might have set up
# some redirections of their own. Depending on the stream config, the process would be stuck waiting for input from
# a handle that never returns data, or the user would never even get to see the actual question.
#
# @internal

# do not allow this file to be sourced from outside of user-interface
[ "$(basename "${BASH_SOURCE[1]}")" != "user-interface.shl" ] && exit

# -----------
# @section Basic implementation

# -----------
# @section Configuration
# @description
# This backend recognizes a few variables which can be used to control IO:
# - `tty_OUTSTREAM`: Where questions and messages intended to be read by the user shall go (default: /dev/tty).  
# - `tty_INSTREAM`: Where the various questions shall look for input values, which is mostly done via `read`.  
#    This is optional. When the variable does not exist, it is not created. The default behaviour is to read stdin.
#
# Both parameters can by pre-defined, in which case valid and open file descriptors are expected as values.
# Any other value which is an integer >1 will simply be ignored and overridden with the defaults.

[ "${tty_OUTSTREAM:-0}" -gt 1 ] || exec {tty_OUTSTREAM}>/dev/tty
#[ "${tty_INSTREAM:-0}" -gt 1 ] || exec {tty_INSTREAM}</dev/tty

# @endsection

# @description
# TTY-style specific implementation of showing a list of choices and asking the user to pick one.  
# For exclusive use from within `ui:askChoice`.
# 
# Choices should be prepared as array with localized texts.
# @arg $1 string text to use
# @arg $2 ref name of an array to use
# @arg $3 int offset to start at (default 0)
# @stdout index number of selected choice
function ui#requestChoiceImpl
{
  local __question="${1:?missing prompt}"
  local -n __data="${2:?no choice array given}"
  local __offset="${3:-0}"
  local __fullPrompt="=> ${__question} ($__offset-${#__data[@]}): "

  local __options=()
  local rpos
  for (( rpos=__offset; rpos <= "${#__data[@]}"; rpos++ )); do
    __options+=("$rpos: ${__data[rpos]}")
  done

  local REPLY=""
  while ! [[ "$REPLY" =~ ^[0-9]+$ ]] || [ -z "${__data[$REPLY]}" ]; do
    "tty#writeLine"
    "tty#out" printf '%s\n' "${__options[@]}"
    "tty#writeLine"
    "tty#getInput" -p "${__fullPrompt}"
  done

  echo "$REPLY"
}

# @description TTY-style implementation of yes/no utilizing `read`.
# @see [ui#requestConfirmationImpl](./backend-api.shl.md#uirequestConfirmationImpl)
function ui#requestConfirmationImpl
{
  local question confirmCharacters
  # shellcheck disable=2034 #variable is used by lc
  question="$1"
  # For console yes/no questions.
  # shellcheck disable=2034 #variable is used by lc
  confirmCharacters=$(lc '[Y/n]')
  local __prompt=$(lc '%%question%% %%confirmCharacters%%:' question confirmCharacters)
  
  "tty#writeLine"
  "tty#getInput" -p "$__prompt"
  [[ "$REPLY" =~ $(locale yesexpr) ]]
}

# @description TTY-style implementation of asking for a directory.
# @see [ui#requestDirectoryImpl](./backend-api.shl.md#uirequestDirectoryImpl)
# TODO: add a note 'leave empty to cancel' to prompt message
function ui#requestDirectoryImpl
{
  # shellcheck disable=2016
  local TAB_COMPLETE_CONFIG='
complete -I -d -o nospace
function verifyInput {
  ui#verify_isDir "$1"
}'

  "tty#writeLine"
  "tty#requestWithCompletion" "$1" "$2"
}

# @description TTY-style implementation of asking for a file.  
# **Note:** This function uses `()` instead of `{}` for the function body
# because it heavily modifies the execution environment to configure `read`.
#
# @see [ui#requestFileImpl](./backend-api.shl.md#uirequestFileImpl)
function ui#requestFileImpl
{
  # set up shell options and completion for read -E
  local __endings=$(_join \| "${@:3}")
  local __exclusion="!*.@(${__endings})"

  local TAB_COMPLETE_CONFIG="
# set file name filter and disable any other bash completion
complete -f -X '$__exclusion' -I -o plusdirs -o default -o nospace
function verifyInput {
  ui#verify_isFileType '${__endings}' \"\$1\"
}"

  local __defaultFile=""
  if [ -n "$2" ] && [ -d "$2" ]; then
    TAB_COMPLETE_CONFIG="${TAB_COMPLETE_CONFIG}"$'\n'"cd '$2'"
  elif [ -f "$2" ]; then
    __defaultFile="$2"
  fi

  "tty#writeLine"
  "tty#requestWithCompletion" "$1" "${__defaultFile}"
}

# @description TTY-style implementation of asking for arbitrary input with `read`.
# @see [ui#requestInputImpl](./backend-api.shl.md#uirequestInputImpl)
function ui#requestInputImpl
{
  "tty#writeLine"
  local REPLY
  "tty#getInput" -ep "$1"$'\n'": " -i "$2"
  REPLY="${REPLY%%[[:space:]]}"
  echo -n "$REPLY"
  [ -n "$REPLY" ] || return 1
}

# @description TTY-style implementation for sending a simple info message. Just prints to tty/stdout.
# @see [ui#sendMessage](./backend-api.shl.md#uisendMessage)
function ui#sendMessage
{
  # `_outOnly` uses `lc` internally as well, to translate and replace parameters
  # but `ui:message` did that already - so skip it this time around
  NO_LC=1 _outOnly "$1"
}

# @endsection

# -----------
# @section Form support

# @description The TTY-style user-interface currently does not support forms.
# @see [ui#formAddField](./backend-api.shl.md#uiformAddField)
function ui#formAddField
{ _printException "Forms are not supported on TTY" && exit 1; }

# @endsection

# @section TTY-specific internal Helpers
# @internal
 
# @description
# This is a helper function to configure `read` with custom completion.
# Needed for `ui#requestDirectoryImpl` and `ui#requestFileImpl`.  
# Runs in a new subshell to not destroy the current environment.
#
# This function requires extensive configuration which is too complicated to be passed as arguments.  
# Instead, it expects a variable named `TAB_COMPLETE_CONFIG` which must contain shell-sourceable code.  
# The variable can contain an arbitrary amount of initialisation or helper code, but should provide
# one `complete` command at least, as the function deletes all pre-defined completions.
#
# Optionally, a function named `verifyInput` can be provided to control verification and output.  
# This function must have the following signature:  
#
# ```bash
# #@arg $1 value to test
# #@stdout adjusted value to use as result or initial value for next iteration
# #@exitcode 0 success - don't ask again
# #@exitcode >0 failure - $1 is not an accepted value, so ask again
# function verifyInput { ... }
# ```
# @arg $1 prompt
# @arg $2 default value
# @requires env TAB_COMPLETE_CONFIG
function tty#requestWithCompletion
(
    # set up shell options and completion for read -E
  shopt -s nocasematch extglob no_empty_cmd_completion
  shopt -u progcomp_alias
  complete -r

  # shellcheck disable=1090
  . <( echo "${TAB_COMPLETE_CONFIG}" )
  _hasFunc verifyInput || function verifyInput { echo "$1"; }

  local REPLY=""
  while ! REPLY=$(verifyInput "$REPLY"); do
    "tty#writeLine" "$(lc 'Current directory'): $(pwd)"
    "tty#getInput" -Ep "$1: " -i "${REPLY:-"${2}"}"
    [ -n "$REPLY" ] || {
      #_logAndOut "Input is empty - return/cancel"
      return $FALSE
    }
  done
  echo -n "$REPLY"
)

# @description Basically echo redirected to `$tty_OUTSTREAM`.
function tty#writeLine
{ echo "$@" >&"${tty_OUTSTREAM}"; }

# @description For more advanced/customized output to `$tty_OUTSTREAM`:
# - Without arguments, the function will simply pipe through its own `stdin`.
# - When given arguments, they will be run as command and its output is redirected instead.
function tty#out
{ [ "$#" -eq 0 ] && cat - || "${@:?read from stdin failed}"; } >&"${tty_OUTSTREAM}"

# @description
# Wraps a read command to pull data from `$tty_INSTREAM` (if given) and write prompts to `$tty_OUTSTREAM`.
function tty#getInput
{ 
  if [ -f "${tty_INSTREAM:-""}" ]; then
    read -r "$@" 2>&"${tty_OUTSTREAM}" <"${tty_INSTREAM}"
  elif [[ "${tty_INSTREAM:-0}" =~ ^[0-9]+$ ]]; then
    read -u "${tty_INSTREAM:-0}" -r "$@" 2>&"${tty_OUTSTREAM}"
  else
    _printException "[tty_INSTREAM] points to a none-existing file or descriptor: ${tty_INSTREAM:-0}" && exit 1;
  fi
}

# @endsection