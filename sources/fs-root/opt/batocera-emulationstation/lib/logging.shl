# @file
# @brief Generic shell utils for logging
# @description
# The functions declared here will generally write to stderr.
# This allows to capture and process the regular output, e.g. by using `$()`.
# 
# The log functions will not reset exit codes of the executing script to 0.  
# Messages intended to be read by the user will be localized to the user's locale,
# lines going into the log files are forced to LC_ALL=C. 
# This will make reading logs much easier when they are included in issue tickets.
#
# **Output control:**  
# The log library uses 2 named file handles which can be used to control output:
# - `log_OUTSTREAM`: Usually points to `&2`.
# - `log_FILESTREAM`: Initialized from the log file name passed when sourcing.
#
# Both variables can be initialized or pre-defined before sourcing this file.
# In this case, the pre-existing variable will not be defined, but taken as is instead,  
# but only in the case that the defined values are integers greater 0.
#
# The variables can also be assigned another fd integer during runtime.  
# However, it will be the calling script's responsibility to manage existing handles (store away, close, restore afterwards etc.).
#
# @internal

# don't re-init log if it was set already
[ -v "${log__outFile}" ] && return 0
source "$(dirname "${BASH_SOURCE[0]}")"/core.shl

log__outFile="$1"

[ "${log_OUTSTREAM:-0}" -gt 0 ] || exec {log_OUTSTREAM}>&2
[ "${log_FILESTREAM:-0}" -gt 0 ] || \
if [ -n "${log__outFile}" ]; then
  mkdir -p "$(dirname "${log__outFile}")"
  exec {log_FILESTREAM}>"${log__outFile}"
else
  lc $'No log file given - write to outstream only\n' >&2
  exec {log_FILESTREAM}>&${log_OUTSTREAM}
fi

if ! type lc &>/dev/null; then
  # fallback to assure output when there is no suitable command of whatever origin
  function lc { echo "$@"; }
fi

_hasFunc _logOnly || \
function _logOnly {
  local RET="$?"
  # shellcheck disable=2034  # 'unused' var is read by `lc`
  local utils_LC_PRINTER=echo 
  LC_ALL=C lc "$@" >&${log_FILESTREAM} || return "$?"
  return "$RET"
}

_hasFunc _outOnly || \
# @description Counterpart to _logOnly
# Mostly useful when messages to localize are build with prefixes (and over multiple nested function calls),
# so _logAndOut can't handle the staged translation and mixed translation behavior
function _outOnly {
  local RET="$?"
  # shellcheck disable=2034  # 'unused' var is read by `lc`
  local utils_LC_PRINTER=echo
  lc "$@" >&${log_OUTSTREAM} || return "$?"
  return "$RET"
}

_hasFunc _logAndOut || \
function _logAndOut {
  local RET="$?"
  _outOnly "$@" || true
  # Don't run `_logOnly` when both streams point to the same location, or the lines would simply be duplicated in different languages
  "log#streamsDiffer" && _logOnly "$@" || true

  return "$RET"
}

_hasFunc _logAndOutWhenDebug || \
# @description Writes a message to the log. When `PRINT_DEBUG` is set, the message also goes to stderr.
function _logAndOutWhenDebug {
  local RET="$?"
  if [ -n "${PRINT_DEBUG}" ] && "log#streamsDiffer"; then
    _logAndOut "$@" || true
  else
    _logOnly "$@" || true
  fi
  return "$RET"
}

_hasFunc _pipeDebugLog || \
# @description For capturing subprocess output via pipes.   
# Redirectes stdin to `$log_FILESTREAM` and (optionally) with `$PRINT_DEBUG` set to `$log_OUTSTREAM`.
# When `$log_FILESTREAM` points to a terminal (e.g. no file was passed when sourcing `logging.shl`),
# stdin is swallowed silently (unless `PRINT_DEBUG` is set).
function _pipeDebugLog {
  if [ -n "${PRINT_DEBUG}" ] && "log#streamsDiffer"; then
    tee -a /dev/fd/"${log_FILESTREAM}" >&${log_OUTSTREAM}
  elif ! [ -t "${log_FILESTREAM}" ] || [ -n "${PRINT_DEBUG}" ]; then
    cat >&${log_FILESTREAM}
  else
    cat - >/dev/null
  fi
}

_hasFunc _printException || \
# @description
# Print a message, followed by a full stack trace. Trace starts just below `_printException`.
# @arg $1 string Message to print 
# @arg $2 string (optional) print function to use (default: _logAndOut") 
function _printException {
  local _msg="$1"
  local _printer="${2:-_logAndOut}"
  NO_LC=true "$_printer" "$(core:callstack "$_msg" 2)"
}

function log#streamsDiffer
{ [ /dev/fd/"${log_OUTSTREAM}" -ef /dev/fd/"${log_FILESTREAM}" ] && return $FALSE || return $TRUE; }

export -f _outOnly _logOnly _logAndOut _logAndOutWhenDebug _pipeDebugLog _printException
